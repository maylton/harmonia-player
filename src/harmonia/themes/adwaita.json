{
  "id": "adwaita",
  "name": "GNOME (Adwaita)",
  "description": "Cores e cantos do libadwaita, seguindo o sistema.",
  "default_variant": "system",
  "palettes": {
    "dark": {
      "bg": "@window_bg_color",
      "sidebar_bg": "@sidebar_bg_color",
      "headerbar_bg": "@headerbar_bg_color",
      "border": "@headerbar_shade_color",
      "hover_bg": "alpha(@window_fg_color, 0.08)",
      "selected_bg": "alpha(@window_fg_color, 0.14)",
      "chip_bg": "alpha(@window_fg_color, 0.08)",
      "chip_hover_bg": "alpha(@window_fg_color, 0.12)",
      "fg": "@window_fg_color",
      "fg_secondary": "alpha(@window_fg_color, 0.92)",
      "fg_tertiary": "alpha(@window_fg_color, 0.86)",
      "fg_muted": "alpha(@window_fg_color, 0.78)",
      "fg_subtle": "alpha(@window_fg_color, 0.72)",
      "fg_dim": "alpha(@window_fg_color, 0.62)",
      "overlay": "@window_fg_color",
      "shadow": "#000000",
      "inverse_bg": "@window_fg_color",
      "inverse_fg": "@window_bg_color",
      "inverse_hover_bg": "alpha(@window_fg_color, 0.85)",
      "destructive_fg": "@error_color",
      "destructive_bg": "@destructive_bg_color",
      "destructive_border": "@error_color",
      "warning_bg": "@warning_bg_color",
      "warning_fg": "@warning_color"
    },
    "light": {
      "bg": "@window_bg_color",
      "sidebar_bg": "@sidebar_bg_color",
      "headerbar_bg": "@headerbar_bg_color",
      "border": "@headerbar_shade_color",
      "hover_bg": "alpha(@window_fg_color, 0.08)",
      "selected_bg": "alpha(@window_fg_color, 0.14)",
      "chip_bg": "alpha(@window_fg_color, 0.08)",
      "chip_hover_bg": "alpha(@window_fg_color, 0.12)",
      "fg": "@window_fg_color",
      "fg_secondary": "alpha(@window_fg_color, 0.92)",
      "fg_tertiary": "alpha(@window_fg_color, 0.86)",
      "fg_muted": "alpha(@window_fg_color, 0.78)",
      "fg_subtle": "alpha(@window_fg_color, 0.72)",
      "fg_dim": "alpha(@window_fg_color, 0.62)",
      "overlay": "@window_fg_color",
      "shadow": "#000000",
      "inverse_bg": "@window_fg_color",
      "inverse_fg": "@window_bg_color",
      "inverse_hover_bg": "alpha(@window_fg_color, 0.85)",
      "destructive_fg": "@error_color",
      "destructive_bg": "@destructive_bg_color",
      "destructive_border": "@error_color",
      "warning_bg": "@warning_bg_color",
      "warning_fg": "@warning_color"
    }
  }
}
