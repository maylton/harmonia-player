[Desktop Entry]
Name=Harmonia
GenericName=Music Player
GenericName[pt_BR]=Reprodutor de música
Comment=Sua biblioteca do YouTube Music no Linux
Comment[en]=Your YouTube Music library on Linux
Exec=@BINDIR@/harmonia
Icon=io.github.harmonia.Harmonia
