Terminal=false
Type=Application
Categories=AudioVideo;Audio;Music;Player;GTK;
Keywords=Music;YouTube;Streaming;Audio;
Keywords[pt_BR]=Música;YouTube;Streaming;Áudio;
StartupNotify=true
